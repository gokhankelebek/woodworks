---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCallBar from '@/components/MobileCallBar.astro';
import ConversionTracking from '@/components/ConversionTracking.astro';
import { BUSINESS } from '@/data/business';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, ogImage = '/og-default.jpg', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${Astro.site}#business`,
  name: BUSINESS.name,
  description:
    'Custom high-end furniture, cabinetry, and architectural millwork for luxury homes and businesses in Las Vegas and Los Angeles.',
  url: String(Astro.site),
  telephone: '+17023431078',
  email: BUSINESS.email,
  slogan: BUSINESS.tagline,
  image: `${Astro.site}og-default.jpg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    postalCode: BUSINESS.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.lat,
    longitude: BUSINESS.geo.lng,
  },
  areaServed: BUSINESS.serviceAreas.map((name) => ({ '@type': 'City', name })),
  sameAs: [BUSINESS.instagram, BUSINESS.facebook],
  openingHours: 'Mo-Sa 08:00-18:00',
  founder: { '@type': 'Person', name: BUSINESS.owner },
  priceRange: '$$$',
};

const schemas = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KT8MDBSV');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f2" />
    <meta name="google-site-verification" content={BUSINESS.searchConsoleVerification} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
    />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${BUSINESS.gaId}`}></script>
    <script is:inline define:vars={{ gaId: BUSINESS.gaId, ownGaId: BUSINESS.ownGaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);
      // Our own property is in the 'own' group, so lib/analytics.ts can send events to it
      // alone (the old property gets its events through GTM).
      gtag('config', ownGaId, { groups: 'own' });
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KT8MDBSV"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <slot />
    <Footer />
    <MobileCallBar />
    <ConversionTracking />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              observer.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
