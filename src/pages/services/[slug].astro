---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CTABand from '@/components/CTABand.astro';
import { SERVICES } from '@/data/services';
import { projectsByCategory } from '@/data/projects';
import { coverFor } from '@/lib/projectImages';
import { BUSINESS } from '@/data/business';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const projects = projectsByCategory(service.category);
const heroProject = projects[0];
const hero = heroProject ? coverFor(heroProject.slug) : null;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    provider: { '@id': `${Astro.site}#business` },
    areaServed: BUSINESS.serviceAreas.map((name) => ({ '@type': 'City', name })),
    description: service.metaDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={service.metaTitle} description={service.metaDescription} schema={schema}>
  <section class="svc-hero">
    {hero && (
      <div class="svc-hero-media">
        <Image
          src={hero}
          alt={`${service.title} by Vegas Vogue Woodworks`}
          widths={[800, 1280, 1920]}
          sizes="100vw"
          loading="eager"
        />
        <div class="svc-hero-scrim"></div>
      </div>
    )}
    <div class="wrap svc-hero-content">
      <p class="eyebrow svc-hero-eyebrow">Services</p>
      <h1>{service.title}</h1>
      <p class="svc-hero-lede">{service.hero}</p>
      <div class="svc-hero-actions">
        <a href="/contact/" class="btn btn--brass">Get a Free Consultation</a>
        <a href={BUSINESS.phoneHref} class="btn btn--ghost-light">Call {BUSINESS.phone}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap svc-intro">
      {service.intro.map((p) => <p class="lede fade-up svc-intro-p">{p}</p>)}
    </div>
  </section>

  <section class="section section--warm">
    <div class="wrap">
      <p class="eyebrow fade-up">What Sets Ours Apart</p>
      <div class="grid grid-2 feature-grid">
        {service.features.map((f) => (
          <div class="feature fade-up">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow fade-up">Proof, Not Promises</p>
        <h2 class="proof-head fade-up">Recent {service.navLabel.toLowerCase()} projects</h2>
        <div class="grid grid-3">
          {projects.slice(0, 3).map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--warm">
    <div class="wrap faq-wrap">
      <p class="eyebrow fade-up">Questions We Hear</p>
      {service.faq.map((f) => (
        <details class="faq fade-up">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CTABand
    title={`Ready to talk about your ${service.navLabel.toLowerCase()}?`}
  />
</Base>

<style>
  .svc-hero { position: relative; min-height: 62vh; display: flex; align-items: flex-end; }
  .svc-hero-media, .svc-hero-media :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .svc-hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(22,19,15,0.3), rgba(22,19,15,0.75));
  }
  .svc-hero-content { position: relative; color: var(--paper); padding: 140px 24px 72px; }
  .svc-hero-eyebrow { color: var(--brass-light); }
  .svc-hero-lede { margin-top: 16px; font-size: 1.15rem; color: rgba(250,247,242,0.85); max-width: 54ch; }
  .svc-hero-actions { display: flex; gap: 16px; margin-top: 30px; flex-wrap: wrap; }

  .svc-intro { max-width: 820px; }
  .svc-intro-p { margin-bottom: 1.4em; font-size: 1.12rem; }

  .feature-grid { margin-top: 32px; }
  .feature { background: var(--paper); border: 1px solid var(--line); padding: 30px; }
  .feature h3 { font-size: 1.3rem; margin-bottom: 8px; }
  .feature p { font-size: 0.95rem; color: rgba(22,19,15,0.7); }

  .proof-head { margin: 10px 0 36px; }

  .faq-wrap { max-width: 820px; }
  .faq {
    border-bottom: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq summary {
    font-family: var(--font-display);
    font-size: 1.25rem; font-weight: 500;
    padding: 16px 0; cursor: pointer; list-style: none;
    position: relative; padding-right: 36px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; position: absolute; right: 4px; top: 14px;
    font-size: 1.4rem; color: var(--brass); transition: transform 0.2s;
  }
  .faq[open] summary::after { transform: rotate(45deg); }
  .faq p { padding: 0 0 18px; color: rgba(22,19,15,0.75); max-width: 68ch; }

  @media (max-width: 720px) {
    .svc-hero { min-height: 70svh; }
    .svc-hero-actions { flex-direction: column; gap: 12px; }
    .svc-hero-actions .btn { width: 100%; justify-content: center; }
    .svc-intro-p { font-size: 1.02rem; }
  }
</style>
