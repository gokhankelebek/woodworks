---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CTABand from '@/components/CTABand.astro';
import { Image } from 'astro:assets';
import { LOCATIONS } from '@/data/locations';
import { PROJECTS, projectsByRegion } from '@/data/projects';
import { coverFor } from '@/lib/projectImages';
import { BUSINESS } from '@/data/business';
import { SERVICES } from '@/data/services';

export function getStaticPaths() {
  return LOCATIONS.map((l) => ({ params: { slug: l.slug }, props: { loc: l } }));
}

const { loc } = Astro.props;
const projects = loc.projectSlugs
  ? loc.projectSlugs
      .map((slug) => PROJECTS.find((p) => p.slug === slug))
      .filter((p) => p !== undefined)
  : projectsByRegion(loc.region);
const hero = projects.length ? coverFor(projects[0].slug) : null;
---

<Base title={loc.metaTitle} description={loc.metaDescription}>
  <section class="loc-hero">
    {hero && (
      <div class="loc-hero-media">
        <Image
          src={hero}
          alt={`Custom woodwork in ${loc.name} by Vegas Vogue Woodworks`}
          widths={[800, 1280, 1920]}
          sizes="100vw"
          loading="eager"
        />
        <div class="loc-hero-scrim"></div>
      </div>
    )}
    <div class="wrap loc-hero-content">
      <p class="eyebrow loc-eyebrow">Service Area</p>
      <h1>{loc.h1}</h1>
      <div class="loc-hero-actions">
        <a href="/contact/" class="btn btn--brass">Start Your Project</a>
        <a href={BUSINESS.phoneHref} class="btn btn--ghost-light">Call {BUSINESS.phone}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap loc-intro">
      {loc.intro.map((p) => <p class="lede fade-up loc-p">{p}</p>)}
    </div>
  </section>

  <section class="section section--warm">
    <div class="wrap">
      <p class="eyebrow fade-up">Neighborhoods We Serve</p>
      <div class="hood-grid">
        {loc.neighborhoods.map((n) => <span class="hood fade-up">{n}</span>)}
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow fade-up">Local Proof</p>
        <p class="lede fade-up proof-lede">{loc.proof}</p>
        <div class="grid grid-3 loc-projects">
          {projects.slice(0, 6).map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--warm">
    <div class="wrap">
      <p class="eyebrow fade-up">Services in {loc.name}</p>
      <div class="svc-links">
        {SERVICES.map((s) => (
          <a class="svc-link fade-up" href={`/services/${s.slug}/`}>{s.title} →</a>
        ))}
      </div>
    </div>
  </section>

  <CTABand title={`Planning a project in ${loc.name}?`} />
</Base>

<style>
  .loc-hero { position: relative; min-height: 58vh; display: flex; align-items: flex-end; }
  .loc-hero-media, .loc-hero-media :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .loc-hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(22,19,15,0.3), rgba(22,19,15,0.75));
  }
  .loc-hero-content { position: relative; color: var(--paper); padding: 130px 24px 68px; }
  .loc-eyebrow { color: var(--brass-light); }
  .loc-hero-actions { display: flex; gap: 16px; margin-top: 28px; flex-wrap: wrap; }
  .loc-intro { max-width: 820px; }
  .loc-p { margin-bottom: 1.4em; font-size: 1.12rem; }
  .hood-grid { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .hood {
    padding: 10px 22px;
    border: 1px solid var(--line);
    background: var(--paper);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
  .proof-lede { margin: 12px 0 40px; }
  .loc-projects { row-gap: 48px; }
  .svc-links { display: grid; gap: 4px; margin-top: 20px; max-width: 560px; }
  .svc-link {
    padding: 14px 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s, padding-left 0.2s;
  }
  .svc-link:hover { color: var(--walnut); padding-left: 8px; }

  @media (max-width: 720px) {
    .loc-hero { min-height: 66svh; }
    .loc-hero-actions { flex-direction: column; gap: 12px; }
    .loc-hero-actions .btn { width: 100%; justify-content: center; }
    .loc-p { font-size: 1.02rem; }
    .hood { padding: 9px 16px; font-size: 0.8rem; }
  }
</style>
