---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CTABand from '@/components/CTABand.astro';
import { PROJECTS, CATEGORY_LABELS } from '@/data/projects';
import { imagesFor } from '@/lib/projectImages';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const images = imagesFor(project.slug);
const [heroImg, ...gallery] = images;

const related = PROJECTS.filter(
  (p) => p.slug !== project.slug && p.category === project.category
).slice(0, 3);

const title = `${project.title} — ${project.location} | Vegas Vogue Woodworks`;
const description = project.summary;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: String(Astro.site) },
      { '@type': 'ListItem', position: 2, name: 'Portfolio', item: `${Astro.site}portfolio/` },
      { '@type': 'ListItem', position: 3, name: project.title },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <article>
    <section class="section project-head">
      <div class="wrap">
        <p class="crumbs">
          <a href="/portfolio/">Portfolio</a>
          <span>/</span>
          <span>{CATEGORY_LABELS[project.category]}</span>
        </p>
        <h1>{project.title}</h1>
        <p class="project-loc">{project.location}</p>
      </div>
    </section>

    <div class="wrap">
      <div class="project-hero fade-up">
        <Image
          src={heroImg}
          alt={`${project.title} in ${project.location} — custom woodwork by Vegas Vogue Woodworks`}
          widths={[800, 1280, 1800]}
          sizes="(max-width: 1200px) 100vw, 1200px"
          loading="eager"
        />
      </div>

      <div class="project-layout">
        <div class="project-copy">
          {project.body.map((para) => <p class="fade-up">{para}</p>)}
        </div>
        {project.details && (
          <aside class="project-details fade-up">
            <p class="details-head">Project Details</p>
            <ul>
              {project.details.map((d) => <li>{d}</li>)}
            </ul>
            <a href="/contact/" class="btn btn--solid details-cta">Start a Project Like This</a>
          </aside>
        )}
      </div>

      {project.video && (
        <div class="project-video fade-up">
          <video src={project.video} controls muted playsinline preload="metadata"></video>
        </div>
      )}

      {gallery.length > 0 && (
        <div class="project-gallery">
          {gallery.map((img, i) => (
            <div class="gallery-item fade-up">
              <Image
                src={img}
                alt={`${project.title}, ${project.location} — detail view ${i + 2} by Vegas Vogue Woodworks`}
                widths={[600, 1000, 1400]}
                sizes="(max-width: 720px) 100vw, 50vw"
              />
            </div>
          ))}
        </div>
      )}
    </div>

    {related.length > 0 && (
      <section class="section section--warm">
        <div class="wrap">
          <p class="eyebrow">More {CATEGORY_LABELS[project.category]}</p>
          <h2 class="related-head">Related work</h2>
          <div class="grid grid-3">
            {related.map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </section>
    )}

    <CTABand
      title="Want something like this?"
      text={`Tell us about your space — we design and build ${CATEGORY_LABELS[project.category].toLowerCase()} for clients across Las Vegas and Los Angeles.`}
    />
  </article>
</Base>

<style>
  .project-head { padding-bottom: 36px; }
  .crumbs {
    display: flex; gap: 10px;
    font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--brass); margin-bottom: 16px;
  }
  .crumbs a:hover { color: var(--walnut); }
  .project-loc {
    margin-top: 12px; font-size: 0.95rem;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(22,19,15,0.55);
  }
  .project-hero :global(img) { width: 100%; height: auto; }
  .project-layout {
    display: grid; grid-template-columns: 1.7fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(40px, 6vw, 72px) 0;
  }
  .project-copy p { margin-bottom: 1.3em; font-size: 1.05rem; color: rgba(22,19,15,0.8); }
  .project-details {
    align-self: start;
    position: sticky; top: 100px;
    background: var(--paper-warm);
    padding: 30px;
    border: 1px solid var(--line);
  }
  .details-head {
    font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--brass); margin-bottom: 14px;
  }
  .project-details ul { list-style: none; margin-bottom: 22px; }
  .project-details li {
    padding: 9px 0 9px 22px; position: relative;
    font-size: 0.9rem; border-bottom: 1px solid var(--line);
  }
  .project-details li::before {
    content: ''; position: absolute; left: 0; top: 17px;
    width: 10px; height: 2px; background: var(--brass);
  }
  .details-cta { width: 100%; justify-content: center; text-align: center; }
  .project-video { margin-bottom: 48px; }
  .project-video video { width: 100%; }
  .project-gallery {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 20px; padding-bottom: clamp(48px, 7vw, 88px);
  }
  .gallery-item :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .related-head { margin: 10px 0 36px; }
  @media (max-width: 860px) {
    .project-layout { grid-template-columns: 1fr; }
    .project-details { position: static; }
    .project-gallery { grid-template-columns: 1fr; }
  }
</style>
