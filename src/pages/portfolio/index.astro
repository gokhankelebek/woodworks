---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CTABand from '@/components/CTABand.astro';
import { PROJECTS, CATEGORY_LABELS } from '@/data/projects';
import type { ProjectCategory } from '@/data/projects';

const categories = Object.entries(CATEGORY_LABELS) as [ProjectCategory, string][];

const title = 'Portfolio — Custom Furniture & Millwork Projects | Vegas Vogue Woodworks';
const description =
  'Explore custom kitchens, walk-in closets, feature walls, one-of-a-kind furniture, and commercial millwork built by Vegas Vogue Woodworks for clients in Las Vegas, Los Angeles, and beyond.';
---

<Base title={title} description={description}>
  <section class="section page-head">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1>Work that speaks quietly, <br />and gets remembered.</h1>
      <p class="lede head-lede">
        Every project below was designed, fabricated, and installed by our own team —
        from Laguna Beach master suites to the busiest restaurant on Fremont Street.
      </p>
    </div>
  </section>

  <section class="portfolio-body">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter projects by category">
        <button class="filter active" data-filter="all" aria-pressed="true">All</button>
        {categories.map(([key, label]) => (
          <button class="filter" data-filter={key} aria-pressed="false">{label}</button>
        ))}
      </div>
      <div class="grid grid-3 portfolio-grid">
        {PROJECTS.map((p, i) => (
          <div class="portfolio-item" data-category={[p.category, ...(p.additionalCategories ?? [])].join(' ')}>
            <ProjectCard project={p} loading={i < 6 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    title="Have a project in mind?"
    text="Every piece in this portfolio started with a conversation. Tell us what you're imagining."
  />
</Base>

<style>
  .page-head { padding-bottom: 24px; }
  .head-lede { margin-top: 18px; }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 40px; }
  .filter {
    font: inherit;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 10px 20px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter:hover { border-color: var(--brass); color: var(--walnut); }
  .filter.active { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .portfolio-body { padding: 40px 0 clamp(64px, 9vw, 120px); }
  .portfolio-grid { row-gap: 48px; }
  .portfolio-item.hidden { display: none; }

  @media (max-width: 720px) {
    /* swipeable chip row, pinned under the header */
    .filters {
      position: sticky;
      top: var(--header-h);
      z-index: 30;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 8px;
      margin: 0 -24px 28px;
      padding: 14px 24px;
      background: rgba(250, 247, 242, 0.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .filters::-webkit-scrollbar { display: none; }
    .filter { flex-shrink: 0; padding: 9px 16px; }
    .portfolio-body { padding-top: 32px; }
    .portfolio-grid { row-gap: 40px; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.portfolio-item');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', String(b === btn));
      });
      btn.classList.add('active');
      const f = btn.dataset.filter;
      items.forEach((item) => {
        item.classList.toggle('hidden', f !== 'all' && !item.dataset.category?.split(' ').includes(f ?? ''));
      });
    });
  });
</script>
