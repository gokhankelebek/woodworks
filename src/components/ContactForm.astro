---
import { BUSINESS } from '@/data/business';
---

<div class="form-success" hidden>
  <p class="success-eyebrow">Request Received</p>
  <h3>Thank you — we'll be in touch within one business day.</h3>
  <p class="success-note">
    Check your inbox for a confirmation. If your project is urgent, call or WhatsApp
    <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a> — you'll reach our design team directly.
  </p>
</div>

<form class="contact-form" action="/api/contact" method="POST">
  <div class="form-row">
    <label>
      <span>Name *</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      <span>Phone *</span>
      <input type="tel" name="phone" required autocomplete="tel" />
    </label>
  </div>

  <div class="form-row">
    <label>
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" />
    </label>
    <label>
      <span>Project Location</span>
      <input type="text" name="location" placeholder="e.g. Summerlin, Newport Beach" />
    </label>
  </div>

  <div class="form-row">
    <label>
      <span>Project Type</span>
      <select name="project_type">
        <option>Custom Kitchen</option>
        <option>Walk-In Closet</option>
        <option>Feature Wall / Paneling</option>
        <option>Custom Furniture Piece</option>
        <option>Home Office / Built-Ins</option>
        <option>Commercial / Restaurant</option>
        <option>Other</option>
      </select>
    </label>
    <label>
      <span>Approximate Budget</span>
      <select name="budget">
        <option>Not sure yet</option>
        <option>$10k – $25k</option>
        <option>$25k – $50k</option>
        <option>$50k – $100k</option>
        <option>$100k+</option>
      </select>
    </label>
  </div>

  <label>
    <span>Tell us about your project</span>
    <textarea name="message" rows="5" placeholder="What are you dreaming of? Inspiration links welcome."></textarea>
  </label>

  <!-- honeypot: humans never see this; bots fill it -->
  <p class="hp" aria-hidden="true">
    <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </p>

  <button type="submit" class="btn btn--solid form-submit">Request My Free Consultation</button>
  <p class="form-status" role="alert" hidden></p>
  <p class="form-alt">
    Prefer to talk? Call or WhatsApp <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
  </p>
</form>

<style>
  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label { display: flex; flex-direction: column; gap: 7px; }
  label span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--walnut);
  }
  input, select, textarea {
    font: inherit;
    padding: 13px 14px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    border-radius: 0;
    -webkit-appearance: none;
  }
  input:focus, select:focus, textarea:focus {
    outline: 2px solid var(--brass);
    outline-offset: -1px;
  }
  .hp { position: absolute; left: -9999px; top: -9999px; }
  .form-submit { margin-top: 6px; align-self: flex-start; }
  .form-status {
    background: #fbeee7;
    border: 1px solid #d9a08a;
    color: #7a2e12;
    padding: 14px 16px;
    font-size: 0.92rem;
  }
  .form-alt { font-size: 0.88rem; color: rgba(22,19,15,0.65); }
  .form-alt a { font-weight: 600; color: var(--walnut); border-bottom: 1px solid var(--brass); }

  .form-success {
    background: var(--paper-warm);
    border: 1px solid var(--brass);
    padding: 36px 32px;
  }
  .success-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 10px;
  }
  .form-success h3 { font-size: 1.55rem; margin-bottom: 12px; }
  .success-note { font-size: 0.95rem; color: rgba(22,19,15,0.75); }
  .success-note a { font-weight: 600; color: var(--walnut); border-bottom: 1px solid var(--brass); }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .form-submit { align-self: stretch; text-align: center; justify-content: center; }
  }
</style>

<script>
  import { completeInquiry } from '@/lib/analytics';
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const success = document.querySelector<HTMLElement>('.form-success');
  const status = form?.querySelector<HTMLElement>('.form-status');
  const submitBtn = form?.querySelector<HTMLButtonElement>('.form-submit');

  const showSuccess = () => {
    if (!form || !success) return;
    form.hidden = true;
    success.hidden = false;
    success.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  const showError = () => {
    if (!status || !submitBtn) return;
    status.hidden = false;
    status.textContent =
      'Something went wrong sending your request. Please call or WhatsApp (702) 343-1078 instead — we answer.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Request My Free Consultation';
  };

  // no-JS fallback lands back here with a query flag
  const params = new URLSearchParams(location.search);
  if (params.get('sent') === '1') showSuccess();
  if (params.get('error') === '1') showError();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    if (status) status.hidden = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok || (await res.json()).ok !== true) throw new Error('Submission failed');
      completeInquiry();
    } catch {
      showError();
    }
  });
</script>
