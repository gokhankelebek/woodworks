---
import { BUSINESS } from '@/data/business';
---

<div class="call-bar">
  <a href={BUSINESS.phoneHref} class="call-bar-btn call-bar-btn--call">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    Call Now
  </a>
  <a href="/contact/" class="call-bar-btn call-bar-btn--quote">Free Consultation</a>
</div>

<style>
  .call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: none;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--brass);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.18);
    transform: translateY(105%);
    transition: transform 0.35s ease;
  }
  .call-bar.visible { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .call-bar { transition: none; }
  }
  .call-bar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 17px 8px calc(17px + env(safe-area-inset-bottom));
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .call-bar-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
  .call-bar-btn--call { background: var(--brass); color: var(--ink); }
  .call-bar-btn--quote { background: var(--ink); color: var(--paper); }
  @media (max-width: 720px) {
    .call-bar { display: grid; }
    :global(body) { padding-bottom: var(--callbar-h); }
  }
</style>

<script>
  // stay out of the hero's way — slide in after the first screenful
  const bar = document.querySelector('.call-bar');
  const update = () => {
    bar?.classList.toggle('visible', window.scrollY > window.innerHeight * 0.55);
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
