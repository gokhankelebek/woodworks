---
import { BUSINESS } from '@/data/business';

const nav = [
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/services/', label: 'Services' },
  { href: '/service-areas/las-vegas/', label: 'Las Vegas' },
  { href: '/service-areas/los-angeles/', label: 'Los Angeles' },
  { href: '/service-areas/orange-county/', label: 'Orange County' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${BUSINESS.name} home`}>
      <svg class="brand-mark" viewBox="540 0 1000 880" fill="currentColor" aria-hidden="true">
        <path transform="translate(573,12)" d="m0 0h49l16 1 13 2 15 1h38l65-3h14l9 3 6 8 13 23 10 18 12 21 10 17 12 21 11 19 8 13 14 26 15 25 14 24 15 26 10 17 12 22 13 21 14 26 9 15 14 27 10 17 7 8 4 1 5-5 6-9 26-48 11-19 12-21 13-22 8-13 10-19 14-23 16-29 10-17 12-20 14-26 13-22 13-24 10-17 8-13 9-17 12-22 6-9 5-4h22l33 3 16 1h114l16-1 11-3h4l-1 4-5 9-13 22-9 9-2 1h-18l-27-2-29-1-48-1h-45l-8 16-13 24-24 42-12 19-16 29-15 25-9 16-13 22-10 16-14 25-12 20-14 25-11 18-10 17-12 21-10 16-12 20-8 16-9 16-10 18-10 20-3 1-4-8-4-10-14-25-13-23-15-26-15-25-17-29-13-23-12-20-11-19-10-17-10-18-14-24-15-26-13-22-15-26-16-28-9-15-12-21-14-25-7-9-5-3-120-1 7 17 7 11 12 19 14 25 7 11 9 16 10 18 12 20 14 24 10 18 13 21 9 17 12 20 16 27 10 18 7 11 9 16 11 20 9 15 15 26 16 27 14 25 13 22 14 24 9 16 11 17 10 14 11 12 14 11 17 10 23 5 15 1 26-4 13-4 16-9 14-11 12-12 7-10 13-23 7-11 15-26 10-18 14-23 10-18 8-13 16-28 9-16 15-25 11-20 12-20 15-26 9-16 8-14 11-20 5-5 213-1 3 1-2 5-7 10-16 25-20 35-8 13-13 23-13 22-9 15-11 19-4 8-12 20-11 19-10 18-10 16-14 25-10 17-12 20-10 18-12 20-15 26-11 20-7 11-9 16-11 19-12 20-14 25-11 19-9 15-12 19-22 24-14 14-13 10-14 9-16 9-19 8-19 6-21 5-21 2h-41l-21-3-20-4-20-7-18-8-17-9-14-10-14-12-14-14-9-11-8-9-14-22-14-24-14-25-13-22-14-24-16-28-14-24-12-21-9-15-12-21-13-22-16-28-10-18-13-21-15-26-12-21-9-15-16-28-9-15-14-24-13-21-12-19-7-11v-2h47l6 7 15 29 9 15 13 23 12 21 9 15 12 21 11 19 9 15 12 22 11 18 15 26 11 20 10 16 15 27 10 16 13 22 10 18 8 13 9 16 12 21 9 15 15 26 11 18 15 22 11 12 10 10 19 14 13 8 16 8 22 9 19 2 10 3 7 1h24l14-4 21-2 17-6 19-9 22-14 13-10 12-11 7-7 12-16 14-22 10-18 9-15 11-20 10-16 12-22 16-27 10-17 15-26 15-25 11-20 10-17 22-38 9-15 8-14 13-23 12-19 14-25 14-24 33-55 5-11-100-1h-23l-6 1-7 16-10 19-9 17-12 19-14 26-11 18-12 22-16 27-6 9-11 21-9 15-8 13-7 13-10 18-18 30-11 19-12 16-16 16-19 13-21 11-24 8-5 1-19 1h-16l-18-1-9-3-12-3-16-7-20-13-10-8-14-14-13-18-40-70-15-26-11-19-17-29-16-28-10-17-14-24-12-21-10-17-9-16-16-27-12-20-13-23-14-24-13-23-19-32-15-26-9-15-14-24-13-22-15-25-11-17-10-15z"/>
      </svg>
      <span class="brand-text">
        <span class="brand-name">Vegas Vogue</span>
        <span class="brand-sub">Woodworks</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: path.startsWith(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <a href={BUSINESS.phoneHref} class="header-phone">
      <span class="phone-label">Free Consultation</span>
      <span class="phone-number">{BUSINESS.phone}</span>
    </a>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- outside <header>: its backdrop-filter would otherwise trap this fixed overlay -->
<nav class="mobile-nav" id="mobile-menu" aria-label="Mobile">
    <div class="mobile-links">
      {nav.map((item, i) => (
        <a
          href={item.href}
          class:list={['mobile-link', { active: path.startsWith(item.href) }]}
          style={`--i: ${i}`}
        >
          <span class="mobile-link-num">0{i + 1}</span>
          {item.label}
        </a>
      ))}
    </div>
    <div class="mobile-contact" style={`--i: ${nav.length}`}>
      <a href={BUSINESS.phoneHref} class="btn btn--brass mobile-call">Call {BUSINESS.phone}</a>
      <p class="mobile-addr">
        {BUSINESS.address.street} · {BUSINESS.address.city}, {BUSINESS.address.state}
      </p>
      <div class="mobile-social">
        <a href={BUSINESS.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={BUSINESS.facebook} rel="noopener" target="_blank">Facebook</a>
      </div>
    </div>
</nav>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-h);
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { width: 38px; flex-shrink: 0; color: var(--ink); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .brand-sub {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .main-nav { display: flex; gap: 24px; margin-left: auto; }
  .nav-link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .nav-link:hover, .nav-link.active { border-color: var(--brass); }

  .header-phone { text-align: right; line-height: 1.25; }
  .phone-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .phone-number { font-weight: 600; font-size: 0.95rem; }

  /* hamburger → X */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: 0;
    padding: 10px;
    margin-right: -10px;
    cursor: pointer;
  }
  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.open span:nth-child(2) { opacity: 0; }
  .nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* full-screen takeover menu */
  .mobile-nav {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 65;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--ink);
    padding: 28px 24px calc(28px + env(safe-area-inset-bottom));
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    overflow-y: auto;
  }
  .mobile-nav.open { opacity: 1; visibility: visible; }

  .mobile-links { display: flex; flex-direction: column; }
  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 6.4vw, 2rem);
    font-weight: 500;
    color: var(--paper);
    padding: 13px 0;
    border-bottom: 1px solid var(--line-light);
  }
  .mobile-link.active { color: var(--brass-light); }
  .mobile-link-num {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--brass);
  }
  .mobile-contact { margin-top: 28px; }
  .mobile-call { width: 100%; justify-content: center; }
  .mobile-addr {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(250, 247, 242, 0.55);
  }
  .mobile-social { display: flex; gap: 20px; margin-top: 10px; }
  .mobile-social a {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-light);
    border-bottom: 1px solid var(--brass);
    padding-bottom: 2px;
  }

  /* staggered reveal */
  .mobile-link, .mobile-contact {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .mobile-nav.open .mobile-link,
  .mobile-nav.open .mobile-contact {
    opacity: 1;
    transform: none;
    transition-delay: calc(60ms + var(--i) * 45ms);
  }

  @media (min-width: 981px) {
    .mobile-nav { display: none; }
  }
  @media (max-width: 980px) {
    .main-nav, .header-phone { display: none; }
    .nav-toggle { display: flex; margin-left: auto; }
  }
  @media (max-width: 720px) {
    .brand { gap: 10px; }
    .brand-mark { width: 30px; }
    .brand-name { font-size: 1rem; }
    .brand-sub { font-size: 0.56rem; letter-spacing: 0.3em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-toggle span, .mobile-nav, .mobile-link, .mobile-contact { transition: none; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.querySelector('.mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = !menu?.classList.contains('open');
    menu?.classList.toggle('open', open);
    toggle.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });
</script>
