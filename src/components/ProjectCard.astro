---
import { Image } from 'astro:assets';
import type { Project } from '@/data/projects';
import { CATEGORY_LABELS } from '@/data/projects';
import { coverFor } from '@/lib/projectImages';

interface Props {
  project: Project;
  loading?: 'lazy' | 'eager';
}
const { project, loading = 'lazy' } = Astro.props;
const cover = coverFor(project.slug);
---

<a href={`/portfolio/${project.slug}/`} class="card fade-up">
  <div class="card-media">
    <Image
      src={cover}
      alt={`${project.title} — custom woodwork in ${project.location} by Vegas Vogue Woodworks`}
      widths={[420, 720, 1080]}
      sizes="(max-width: 720px) 100vw, 33vw"
      loading={loading}
    />
  </div>
  <div class="card-body">
    <p class="card-meta">
      <span>{CATEGORY_LABELS[project.category]}</span>
      <span class="card-dot">·</span>
      <span>{project.location}</span>
    </p>
    <h3 class="card-title">{project.title}</h3>
  </div>
</a>

<style>
  .card { display: block; }
  .card-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--paper-warm);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .card:hover .card-media :global(img) { transform: scale(1.045); }
  .card-body { padding: 18px 2px 0; }
  .card-meta {
    display: flex;
    gap: 8px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .card-dot { opacity: 0.5; }
  .card-title {
    margin-top: 6px;
    font-size: 1.35rem;
    transition: color 0.2s;
  }
  .card:hover .card-title { color: var(--walnut); }
</style>
