---
import { BUSINESS } from '@/data/business';
import { SERVICES } from '@/data/services';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-logo">Vegas Vogue <span>Woodworks</span></p>
        <p class="footer-tag">{BUSINESS.tagline}</p>
        <div class="footer-social">
          <a href={BUSINESS.instagram} rel="noopener" target="_blank">Instagram</a>
          <a href={BUSINESS.facebook} rel="noopener" target="_blank">Facebook</a>
        </div>
      </div>

      <div>
        <p class="footer-head">Services</p>
        {SERVICES.map((s) => (
          <a class="footer-link" href={`/services/${s.slug}/`}>{s.navLabel}</a>
        ))}
      </div>

      <div>
        <p class="footer-head">Company</p>
        <a class="footer-link" href="/portfolio/">Portfolio</a>
        <a class="footer-link" href="/about/">About Us</a>
        <a class="footer-link" href="/service-areas/las-vegas/">Las Vegas</a>
        <a class="footer-link" href="/service-areas/los-angeles/">Los Angeles</a>
        <a class="footer-link" href="/service-areas/orange-county/">Orange County</a>
        <a class="footer-link" href="/contact/">Contact</a>
        <a class="footer-link" href={BUSINESS.expoUrl} target="_blank" rel="noopener">Our sister company · Vegas Vogue Expo ↗</a>
      </div>

      <div>
        <p class="footer-head">Visit or Call</p>
        <address class="footer-address">
          {BUSINESS.address.street}<br />
          {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}
        </address>
        <a class="footer-link" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
        <a class="footer-link" href={BUSINESS.mapsUrl} target="_blank" rel="noopener">Get Directions →</a>
        <a class="footer-link" href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
        <p class="footer-hours">{BUSINESS.hours}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {BUSINESS.name}. All rights reserved.</p>
      <p>Custom furniture &amp; millwork — Las Vegas · Los Angeles</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(250, 247, 242, 0.82);
    padding: 72px 0 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 40px;
  }
  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--paper);
  }
  .footer-logo span { color: var(--brass); }
  .footer-tag { font-size: 0.85rem; margin-top: 8px; opacity: 0.7; }
  .footer-social { display: flex; gap: 18px; margin-top: 18px; }
  .footer-social a {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--brass);
    padding-bottom: 2px;
  }
  .footer-head {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 14px;
  }
  .footer-link {
    display: block;
    padding: 5px 0;
    font-size: 0.9rem;
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .footer-link:hover { opacity: 1; color: var(--brass-light); }
  .footer-address { font-style: normal; font-size: 0.9rem; margin-bottom: 8px; opacity: 0.85; }
  .footer-hours { font-size: 0.82rem; margin-top: 10px; opacity: 0.6; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line-light);
    font-size: 0.78rem;
    opacity: 0.55;
  }
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
